# ── Application ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────
# App role MUST be a non-superuser without BYPASSRLS so Row-Level Security is enforced.
DATABASE_URL=postgresql://restaurant:restaurant@localhost:5432/restaurant_dev?schema=public

# ── JWT / Auth ────────────────────────────────────────────────────────────
# Generate strong random secrets in production (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_REFRESH_TTL=1209600
PASSWORD_RESET_TTL=3600

# ── Security ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=10

# ── External services ─────────────────────────────────────────────────────
VIACEP_BASE_URL=https://viacep.com.br/ws
