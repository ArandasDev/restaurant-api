  "info": {
    "title": "Restaurant SaaS API",
    "description": "Multi-tenant e-commerce API for restaurants.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {}
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR",
            "description": "Stable machine-readable error code (see docs/ERRORS.md)."
          },
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "details": {
            "type": "object",
            "description": "Optional field-level or contextual details.",
            "example": {
              "fields": {
                "email": "must be a valid email"
              }
            }
          },
          "timestamp": {
            "type": "string",
            "example": "2026-07-30T12:00:00.000Z"
          },
          "path": {
            "type": "string",
            "example": "/api/v1/auth/login"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message",
          "timestamp",
          "path"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "maria@example.com"
          },
          "password": {
            "type": "string",
            "example": "Str0ng!Pass"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokensResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Access token lifetime in seconds."
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The opaque refresh token (`<id>.<secret>`)."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refresh token to revoke."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "maria@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "If the account exists, a reset link has been sent."
          }
        },
        "required": [
          "message"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The password-reset token (`<id>.<secret>`)."
          },
          "newPassword": {
            "type": "string",
            "example": "Str0ng!Pass",
            "minLength": 8,
            "maxLength": 128,
            "description": "At least one lowercase, one uppercase, one digit and one special character."
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "CreateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Pizzaria do Bairro"
          },
          "slug": {
            "type": "string",
            "example": "pizzaria-do-bairro",
            "description": "URL-safe unique identifier (lowercase, digits and hyphens)."
          },
          "adminEmail": {
            "type": "string",
            "example": "owner@pizzaria.com"
          },
          "adminPassword": {
            "type": "string",
            "example": "Str0ng!Pass",
            "minLength": 8,
            "maxLength": 128,
            "description": "At least one lowercase, one uppercase, one digit and one special character."
          }
        },
        "required": [
          "name",
          "slug",
          "adminEmail",
          "adminPassword"
        ]
      },
      "TenantCreatedResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "adminUserId": {
            "type": "string",
            "description": "Id of the created TENANT_ADMIN user."
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "adminUserId"
        ]
      },
      "RegisterConsumerDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "maria@example.com"
          },
          "password": {
            "type": "string",
            "example": "Str0ng!Pass",
            "minLength": 8,
            "maxLength": 128,
            "description": "At least one lowercase, one uppercase, one digit and one special character."
          },
          "name": {
            "type": "string",
            "example": "Maria Silva"
          },
          "phone": {
            "type": "string",
            "example": "5511999998888",
            "description": "10–15 digits, optional +."
          },
          "cpf": {
            "type": "string",
            "example": "12345678901",
            "description": "11-digit CPF."
          }
        },
        "required": [
          "email",
          "password",
          "name",
          "phone"
        ]
      },
      "ConsumerResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "cpf": {
            "type": "object",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "phone",
          "createdAt"
        ]
      },
      "UpdateConsumerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Maria S. Souza"
          },
          "phone": {
            "type": "string",
            "example": "5511988887777"
          },
          "cpf": {
            "type": "string",
            "example": "12345678901"
          }
        }
      },
      "CepResponse": {
        "type": "object",
        "properties": {
          "cep": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "cep",
          "street",
          "district",
          "city",
          "state"
        ]
      },
      "AddressResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "cep": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "complement": {
            "type": "object",
            "nullable": true
          },
          "district": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "latitude": {
            "type": "object",
            "nullable": true
          },
          "longitude": {
            "type": "object",
            "nullable": true
          },
          "isPrimary": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "cep",
          "street",
          "number",
          "district",
          "city",
          "state",
          "isPrimary"
        ]
      },
      "CreateAddressDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "example": "Casa"
          },
          "cep": {
            "type": "string",
            "example": "01001-000",
            "description": "CEP (8 digits, mask optional)."
          },
          "number": {
            "type": "string",
            "example": "123"
          },
          "street": {
            "type": "string",
            "example": "Praça da Sé",
            "description": "Filled from CEP if omitted."
          },
          "complement": {
            "type": "string",
            "example": "Apto 42"
          },
          "district": {
            "type": "string",
            "example": "Sé"
          },
          "city": {
            "type": "string",
            "example": "São Paulo"
          },
          "state": {
            "type": "string",
            "example": "SP",
            "description": "2-letter state (UF)."
          },
          "latitude": {
            "type": "number",
            "example": -23.5505,
            "description": "GPS latitude."
          },
          "longitude": {
            "type": "number",
            "example": -46.6333,
            "description": "GPS longitude."
          },
          "isPrimary": {
            "type": "boolean",
            "example": false,
            "description": "Set as the primary address."
          }
        },
        "required": [
          "label",
          "cep",
